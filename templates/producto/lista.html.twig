{% extends "base.html.twig" %}

{% block title %}Lista de productos{% endblock %}

{% block stylesheets %}
    {{ parent() }} {# Esto carga el estilos.css del bloque padre #}
{% endblock %}

{% block body %}
<div class="navegador">
    <h2>Carrito de compras-{{ app.user.email }}</h2>

    <div>
        <button type="button" class="botones">Ver orden</button>
        <button type="button" class="botones2">Salir</button>
    </div>
</div>

<h2>Esta es la lista de productos</h2>
<div class="productos-grid">
    {% for producto in productos %}
        <div class="producto-card">
            <img src="{{ asset(producto.imagen) }}" alt="{{ producto.nombre }}">
            <h3>{{ producto.nombre }}</h3>
            <p>{{ producto.descripcion }}</p>
            <p><strong>Precio:</strong> ${{ producto.precio }}</p>
        </div>
    {% else %}
        <p>No hay productos disponibles.</p>
    {% endfor %}
</div>
{% endblock %}



{# hay que limitar con block y su nombre en el archivo padre haciendo alucion a alguna etiqueta especifica de 
html para que las mismas partes que queremos que hereden del padre en otra pagina html tengan la 
herencia. En la pagina hija hay que poner solamente las etiquetas block con el mismo nombre haciendo alucion 
al pedazo de bloque que queremos que herede del padre #}